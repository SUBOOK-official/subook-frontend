{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build:public",
  "outputDirectory": "frontend/apps/public-web/dist",
  "redirects": [
    {
      "source": "/products/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/sitemap-products"
    },
    {
      "source": "/store/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa).*"
        }
      ],
      "destination": "/api/prerender-product?id=:id"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" }
      ]
    }
  ]
}

{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build:public",
  "outputDirectory": "frontend/apps/public-web/dist",
  "functions": { "api/banner-copy.js": { "maxDuration": 180 } },
  "crons": [{ "path": "/api/banner-copy?refresh=1", "schedule": "*/10 * * * *" }],
  "redirects": [
    {
      "source": "/sell/",
      "destination": "/sell",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/posts/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/boards/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/question/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/categories/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-page/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/qna/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/sitemap-products"
    },
    {
      "source": "/store/subject/:subject",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa|daum/|daumwebmastertool|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|perplexitybot|perplexity-user|meta-externalagent|meta-externalfetcher|meta-webindexer|amazonbot|ccbot|bytespider|mistralai-user).*"
        }
      ],
      "destination": "/api/prerender-subject?subject=:subject"
    },
    {
      "source": "/store/series/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa|daum/|daumwebmastertool|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|perplexitybot|perplexity-user|meta-externalagent|meta-externalfetcher|meta-webindexer|amazonbot|ccbot|bytespider|mistralai-user).*"
        }
      ],
      "destination": "/api/prerender-collection?type=series&key=:key"
    },
    {
      "source": "/store/instructor/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa|daum/|daumwebmastertool|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|perplexitybot|perplexity-user|meta-externalagent|meta-externalfetcher|meta-webindexer|amazonbot|ccbot|bytespider|mistralai-user).*"
        }
      ],
      "destination": "/api/prerender-collection?type=instructor&key=:key"
    },
    {
      "source": "/store/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa|daum/|daumwebmastertool|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|perplexitybot|perplexity-user|meta-externalagent|meta-externalfetcher|meta-webindexer|amazonbot|ccbot|bytespider|mistralai-user).*"
        }
      ],
      "destination": "/api/prerender-product?id=:id"
    },
    {
      "source": "/faq",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa|daum/|daumwebmastertool|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|perplexitybot|perplexity-user|meta-externalagent|meta-externalfetcher|meta-webindexer|amazonbot|ccbot|bytespider|mistralai-user).*"
        }
      ],
      "destination": "/api/prerender-faq"
    },
    {
      "source": "/sell",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(yeti|naverbot|googlebot|google-inspectiontool|bingbot|kakaotalk-scrap|kakaostory-og-reader|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|discordbot|applebot|petalbot|duckduckbot|baiduspider|yandexbot|daumoa|daum/|daumwebmastertool|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-user|claude-searchbot|perplexitybot|perplexity-user|meta-externalagent|meta-externalfetcher|meta-webindexer|amazonbot|ccbot|bytespider|mistralai-user).*"
        }
      ],
      "destination": "/sell-crawler.html"
    },
    {
      "source": "/sell",
      "destination": "/sell-page.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; report-uri /api/csp-report?app=public&mode=enforce" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'report-sample' https://www.googletagmanager.com https://connect.facebook.net https://pay.nicepay.co.kr https://js.tosspayments.com https://t1.daumcdn.net https://t1.kakaocdn.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.google.co.kr https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://*.facebook.com https://*.facebook.net https://*.nicepay.co.kr https://*.tosspayments.com; frame-src 'self' https:; worker-src 'self' blob:; child-src 'self' blob: https:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.nicepay.co.kr https://*.tosspayments.com https://www.facebook.com; frame-ancestors 'self'; report-uri /api/csp-report?app=public&mode=report" }
      ]
    }
  ]
}

{
  "expo": {
    "name": "수북",
    "slug": "subook-mobile",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "../public-web/public/apple-touch-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.subook.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "../public-web/public/favicon.png",
      "name": "수북 앱 개발 미리보기"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-sensors",
        {
          "motionPermission": "흔들어서 포춘쿠키를 여는 데 기기 움직임을 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "../public-web/src/assets/brand/logo-horizontal.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withPaymentApps.cjs"
    ],
    "scheme": "subook",
    "backgroundColor": "#FFFFFF",
    "android": {
      "package": "kr.subook.app"
    },
    "extra": {
      "eas": {
        "projectId": "2046176f-7a48-46b9-8531-f81eb35a9fe0"
      }
    },
    "owner": "seongwoooook",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2046176f-7a48-46b9-8531-f81eb35a9fe0"
    }
  }
}

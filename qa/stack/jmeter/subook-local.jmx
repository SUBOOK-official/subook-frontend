<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SUBOOK local handler baseline" enabled="true"><stringProp name="TestPlan.comments">Local only. Real handlers / fixture upstream. 50% B2B, 25% auth guard, 25% cancelled payment guard. Not production capacity.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree>

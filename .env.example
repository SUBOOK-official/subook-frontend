# 이 파일을 복사해 같은 위치에 .env 로 저장하고 실제 값을 채운다. (.env는 커밋 금지)
# 값 위치: Supabase Dashboard → Project Settings → API (URL, anon public key)
# 주의: 환경변수는 dev 서버 시작 시점에 주입되므로 .env 수정 후 dev 서버 재시작 필요.

# public-web (subook.kr) — 로컬 실행: npm --prefix frontend run dev:public
VITE_SUPABASE_PUBLIC_URL=
VITE_SUPABASE_PUBLIC_ANON_KEY=

# admin-web (admin.subook.kr) — 로컬 실행: npm --prefix frontend run dev:admin
VITE_SUPABASE_ADMIN_URL=
VITE_SUPABASE_ADMIN_ANON_KEY=
